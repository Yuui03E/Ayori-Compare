    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22",
    "svelte-check": "^4",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
